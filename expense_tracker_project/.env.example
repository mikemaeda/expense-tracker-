# Copy this file to .env and replace the placeholder values with your real SMTP credentials.
# Do NOT commit .env to source control if it contains your real password.

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your@gmail.com
MAIL_USE_TLS=True

# Optional secret key for Flask session encryption.
FLASK_SECRET_KEY=super-secret-key

# Google OAuth credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
